## PostgreSQL connection string
DATABASE_STRING=postgresql://user:password@localhost:5432/mockingbird

## Auth.js (NextAuth v5)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public base URL of the app (OAuth callbacks are built from it)
NEXTAUTH_URL=http://localhost:3000

## OAuth login providers
# Google (https://console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub (https://github.com/settings/developers → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Discord (https://discord.com/developers/applications → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

## Meta app (Facebook pages + Instagram)
FB_APP_ID=
FB_APP_SECRET=

## X (Twitter) API — OAuth 1.0a consumer keys
X_API_KEY=
X_API_KEY_SECRET=

## Telegram bot token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

## Cloudinary (media upload & processing)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Public values, inlined into the browser bundle at build time (Docker: build args)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

## Shared secret for the cron-triggered webhooks
## (POST /api/webhooks/publish and /api/webhooks/cleanup-media, header x-webhook-secret)
WEBHOOK_SECRET=
