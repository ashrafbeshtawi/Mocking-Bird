# Copy to .env and adjust. Never commit .env.
APP_ENV=dev
APP_SECRET=change-me-32-hex-chars
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8090

# Matches the docker-compose db service (host port 5440).
# The test suite connects to the same server and appends "_test" to the db name.
DATABASE_URL="postgresql://mockingbird:mockingbird@127.0.0.1:5440/mockingbird?serverVersion=18&charset=utf8"
